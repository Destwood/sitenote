{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:root": {
      "inputs": [
        "eslint.config.js",
        "vitest.config.ts",
        "scripts/**",
        "tsconfig.json",
        "package.json"
      ]
    },
    "//#typecheck:root": {
      "inputs": ["vitest.config.ts", "scripts/**", "tsconfig.json", "package.json"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "typecheck": {
      "dependsOn": ["//#typecheck:root"]
    },
    "test": {
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"],
      "cache": false
    },
    "test:rls": {
      "cache": false,
      "passThroughEnv": ["CI", "SUPABASE_*"]
    }
  }
}
