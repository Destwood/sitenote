{
  "name": "sitenote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "node scripts/require-supabase.ts && turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint eslint.config.js vitest.config.ts scripts",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "check:manifest": "node scripts/assert-production-manifest.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:env": "node scripts/supabase-env.ts",
    "db:types": "node scripts/db-types.ts",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "test:rls": "turbo run test:rls"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@sitenote/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
